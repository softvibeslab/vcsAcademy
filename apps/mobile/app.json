{
  "expo": {
    "name": "VCSA Pocket",
    "slug": "vcsa-pocket",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vcsa.pocket"
    },
    "android": {
      "package": "com.vcsa.pocket",
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "b620dee4-5ca7-4939-9b9a-9fc22482a70c"
      }
    }
  }
}
